rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // PRODUCTS
    // =========================
    match /products/{productId} {

      // อ่านสินค้า
      allow read: if resource.data.approved == true
        || (request.auth != null
            && resource.data.uid == request.auth.uid)
        || isAdmin();

      // เพิ่มสินค้า
      allow create: if isSchoolUser()
        && request.resource.data.uid == request.auth.uid
        && validProduct(request.resource.data);

      // แก้ไขสินค้า
      allow update: if
        (
          isSchoolUser()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved == resource.data.approved
          && request.resource.diff(resource).affectedKeys().hasOnly([
            'name',
            'price',
            'cat',
            'desc',
            'seller',
            'room',
            'line',
            'image'
          ])
          && validProduct(request.resource.data)
        )
        ||
        (
          isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved is bool
          && validProduct(request.resource.data)
        );

      // ลบสินค้า
      allow delete: if
        (
          isSchoolUser()
          && resource.data.uid == request.auth.uid
        )
        || isAdmin();
    }


    // =========================
    // MESSAGES / CHAT
    // =========================
    match /messages/{messageId} {

      /*
       * ส่งข้อความได้ 2 กรณี
       *
       * 1. คนซื้อส่งหาคนขาย
       * 2. คนขายตอบกลับคนซื้อ
       *
       * ต้องเป็นสมาชิกใน participantUids
       * และ sellerUid ต้องตรงกับเจ้าของสินค้าจริง
       */
      allow create: if
        isSchoolUser()

        // ผู้ส่งต้องเป็นตัวเอง
        && request.resource.data.senderUid == request.auth.uid

        // email ต้องตรงกับบัญชีที่ล็อกอิน
        && request.resource.data.senderEmail
            == request.auth.token.email

        && request.resource.data.senderEmail is string

        // ข้อมูลพื้นฐาน
        && request.resource.data.productId is string
        && request.resource.data.conversationId is string
        && request.resource.data.text is string

        // ความยาวข้อความ
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500

        // sellerUid ต้องเป็นเจ้าของสินค้าจริง
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.uid == request.resource.data.sellerUid

        // สินค้าต้องได้รับอนุมัติแล้ว
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.approved == true

        // ผู้ส่งต้องอยู่ในคู่สนทนา
        && request.auth.uid in request.resource.data.participantUids

        // seller ต้องอยู่ในคู่สนทนา
        && request.resource.data.sellerUid
            in request.resource.data.participantUids

        // ต้องมีผู้สนทนา 2 คน
        && request.resource.data.participantUids.size() == 2

        /*
         * กรณีคนขายตอบ:
         * ผู้ส่งต้องเป็นเจ้าของสินค้า
         */
        && (
          request.auth.uid == request.resource.data.sellerUid

          ||

          /*
           * กรณีคนซื้อส่ง:
           * ผู้ส่งต้องไม่ใช่ seller
           */
          request.auth.uid != request.resource.data.sellerUid
        );


      // อ่านแชท
      allow read: if
        isAdmin()
        ||
        (
          request.auth != null
          && request.auth.uid in resource.data.participantUids
        );


      // ลบข้อความ
      allow delete: if
        isAdmin()
        ||
        (
          request.auth != null
          && request.auth.uid in resource.data.participantUids
        );
    }


    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      // ผู้ใช้ที่ล็อกอินสามารถอ่านข้อมูล user ได้
      allow read: if request.auth != null;

      // สร้าง / แก้ไขเฉพาะข้อมูลของตัวเอง
      allow create, update: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
    }


    // =========================
    // FUNCTIONS
    // =========================

    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email.matches(
          '.*@triamudomsouth[.]ac[.]th'
        );
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email
          == '11076@triamudomsouth.ac.th';
    }


    // =========================
    // PRODUCT VALIDATION
    // =========================

    function validProduct(data) {
      return data.keys().hasAll([
          'name',
          'price',
          'cat',
          'desc',
          'seller',
          'room',
          'line',
          'image',
          'uid',
          'createdAt'
        ])

        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120

        && data.price is number
        && data.price >= 0
        && data.price <= 1000000

        && data.cat is string

        && data.desc is string
        && data.desc.size() <= 1000

        && data.seller is string
        && data.seller.size() > 0
        && data.seller.size() <= 80

        && data.room is string
        && data.room.size() <= 40

        && data.line is string
        && data.line.size() <= 80

        && data.uid is string

        && (data.image == null || data.image is string);
    }
  }
}
