rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // PRODUCTS
    // =========================
    match /products/{productId} {

      // อ่านสินค้า:
      // - ทุกคนอ่านสินค้าที่ approved
      // - เจ้าของสินค้าอ่านของตัวเองได้
      // - Admin อ่านได้ทั้งหมด
      allow read: if
        resource.data.approved == true
        || (request.auth != null && resource.data.uid == request.auth.uid)
        || isAdmin();

      // เพิ่มสินค้า
      allow create: if
        isSchoolUser()
        && request.resource.data.uid == request.auth.uid
        && validProduct(request.resource.data);

      // แก้ไขสินค้า
      allow update: if
        (
          isSchoolUser()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved == resource.data.approved
          && request.resource.diff(resource).affectedKeys().hasOnly([
            'name',
            'price',
            'cat',
            'desc',
            'seller',
            'room',
            'line',
            'image'
          ])
          && validProduct(request.resource.data)
        )
        ||
        (
          isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved is bool
          && validProduct(request.resource.data)
        );

      // ลบสินค้า
      allow delete: if
        (isSchoolUser() && resource.data.uid == request.auth.uid)
        || isAdmin();
    }


    // =========================
    // MESSAGES / CHAT
    // =========================
    match /messages/{messageId} {

      // ส่งข้อความ
      allow create: if
        isSchoolUser()

        // คนส่งต้องเป็นบัญชีที่ Login อยู่
        && request.resource.data.senderUid == request.auth.uid

        // ตรวจข้อมูลพื้นฐาน
        && request.resource.data.senderEmail is string
        && request.resource.data.productId is string
        && request.resource.data.conversationId is string
        && request.resource.data.text is string

        // ความยาวข้อความ
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500

        // ต้องมีผู้สนทนา 2 คน
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2

        // ต้องเป็นคนละ UID
        && request.resource.data.participantUids[0]
           != request.resource.data.participantUids[1]

        // คนส่งต้องอยู่ในห้อง
        && request.auth.uid in request.resource.data.participantUids

        // seller ต้องอยู่ในห้อง
        && request.resource.data.sellerUid
           in request.resource.data.participantUids

        // sellerUid ต้องเป็นเจ้าของสินค้าจริง
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.uid == request.resource.data.sellerUid

        // สินค้าต้องผ่านการอนุมัติ
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.approved == true;


      // อ่านข้อความ
      allow read: if
        isAdmin()
        ||
        (
          request.auth != null
          && resource.data.participantUids is list
          && request.auth.uid in resource.data.participantUids
        );


      // ลบข้อความ
      allow delete: if
        isAdmin()
        ||
        (
          request.auth != null
          && resource.data.participantUids is list
          && request.auth.uid in resource.data.participantUids
        );
    }


    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      // ผู้ใช้ที่ Login แล้วอ่านข้อมูลได้
      allow read: if request.auth != null;

      // สร้าง/แก้ข้อมูลตัวเอง
      allow create, update: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
    }


    // =========================
    // FUNCTIONS
    // =========================

    // อนุญาตเฉพาะอีเมลโรงเรียน
    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches(
          '.*@triamudomsouth[.]ac[.]th'
        );
    }

    // Admin
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == '11076@triamudomsouth.ac.th';
    }


    // ตรวจข้อมูลสินค้า
    function validProduct(data) {
      return data.keys().hasAll([
        'name',
        'price',
        'cat',
        'desc',
        'seller',
        'room',
        'line',
        'image',
        'uid',
        'createdAt'
      ])

      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120

      && data.price is number
      && data.price >= 0
      && data.price <= 1000000

      && data.cat is string

      && data.desc is string
      && data.desc.size() <= 1000

      && data.seller is string
      && data.seller.size() > 0
      && data.seller.size() <= 80

      && data.room is string
      && data.room.size() <= 40

      && data.line is string
      && data.line.size() <= 80

      && data.uid is string

      && (data.image == null || data.image is string);
    }
  }
}
