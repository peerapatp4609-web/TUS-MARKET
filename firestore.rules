rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if
        resource.data.approved == true
        || (request.auth != null && resource.data.uid == request.auth.uid)
        || isAdmin();

      allow create: if
        isSchoolUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.approved == false
        && request.resource.data.moderationStatus == 'pending_manual'
        && validProduct(request.resource.data);

      allow update: if
        (
          isSchoolUser()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.diff(resource).affectedKeys().hasOnly([
            'name','price','cat','desc','seller','room','line','image'
          ])
          && validProduct(request.resource.data)
        )
        ||
        (
          isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.approved is bool
          && validProduct(request.resource.data)
        );

      allow delete: if
        (isSchoolUser() && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    match /messages/{messageId} {
      allow create: if
        isSchoolUser()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.senderEmail is string
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.productId is string
        && request.resource.data.conversationId is string
        && request.resource.data.sellerUid is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0] != request.resource.data.participantUids[1]
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.sellerUid in request.resource.data.participantUids
        && request.resource.data.createdAt is timestamp
        && (request.resource.data.senderPhotoUrl == null || request.resource.data.senderPhotoUrl is string)
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.uid == request.resource.data.sellerUid;

      allow read: if
        isAdmin()
        || (
          request.auth != null
          && resource.data.participantUids is list
          && request.auth.uid in resource.data.participantUids
        );

      allow update: if false;

      allow delete: if
        isAdmin()
        || (
          request.auth != null
          && resource.data.participantUids is list
          && request.auth.uid in resource.data.participantUids
          && resource.data.senderUid == request.auth.uid
        );
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string);
    }

    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@triamudomsouth[.]ac[.]th');
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == '11076@triamudomsouth.ac.th';
    }

    function validProduct(data) {
      return data.keys().hasAll([
        'name','price','cat','desc','seller','room','line','image','uid','createdAt','approved'
      ])
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120
      && data.price is number
      && data.price >= 0
      && data.price <= 1000000
      && data.cat is string
      && data.desc is string
      && data.desc.size() <= 1000
      && data.seller is string
      && data.seller.size() > 0
      && data.seller.size() <= 80
      && data.room is string
      && data.room.size() <= 40
      && data.line is string
      && data.line.size() <= 80
      && data.uid is string
      && data.createdAt is timestamp
      && data.approved is bool
      && (data.image == null || (data.image is string && data.image.size() <= 900000));
    }
  }
}
