rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // PRODUCTS
    // =========================
    match /products/{productId} {

      allow read: if
        resource.data.approved == true
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
        )
        || isAdmin();

      allow create: if
        isSchoolUser()
        && request.resource.data.uid == request.auth.uid
        && validProduct(request.resource.data);

      allow update: if
        (
          isSchoolUser()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved == resource.data.approved
          && request.resource.diff(resource).affectedKeys().hasOnly([
            'name',
            'price',
            'cat',
            'desc',
            'seller',
            'room',
            'line',
            'image'
          ])
          && validProduct(request.resource.data)
        )
        ||
        (
          isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved is bool
          && validProduct(request.resource.data)
        );

      allow delete: if
        (
          isSchoolUser()
          && resource.data.uid == request.auth.uid
        )
        || isAdmin();
    }


    // =========================
    // MESSAGES / CHAT
    // =========================
    match /messages/{messageId} {

      // ผู้ซื้อและผู้ขายสามารถส่งข้อความได้
      allow create: if
        isSchoolUser()

        // sender ต้องเป็นบัญชีที่กำลังล็อกอิน
        && request.resource.data.senderUid == request.auth.uid

        // email ต้องตรงกับ Firebase Auth
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.senderEmail is string

        // ข้อมูลหลัก
        && request.resource.data.productId is string
        && request.resource.data.conversationId is string
        && request.resource.data.text is string

        // ข้อความต้องไม่ว่าง และไม่เกิน 500 ตัว
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500

        // participantUids ต้องเป็น list
        && request.resource.data.participantUids is list

        // ต้องมีผู้สนทนา 2 คน
        && request.resource.data.participantUids.size() == 2

        // UID ทั้งสองต้องไม่ซ้ำกัน
        && request.resource.data.participantUids[0]
           != request.resource.data.participantUids[1]

        // sender ต้องอยู่ใน participantUids
        && request.auth.uid in request.resource.data.participantUids

        // seller ต้องอยู่ใน participantUids
        && request.resource.data.sellerUid
           in request.resource.data.participantUids

        // sellerUid ต้องเป็นเจ้าของสินค้าจริง
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.uid == request.resource.data.sellerUid

        // สินค้าต้องผ่านการอนุมัติ
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.approved == true;


      // อ่านข้อความได้เฉพาะคู่สนทนา
      allow read: if
        isAdmin()
        ||
        (
          request.auth != null
          && request.auth.uid in resource.data.participantUids
        );


      // ลบข้อความได้เฉพาะคู่สนทนาหรือ Admin
      allow delete: if
        isAdmin()
        ||
        (
          request.auth != null
          && request.auth.uid in resource.data.participantUids
        );
    }


    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      allow read: if request.auth != null;

      allow create, update: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
    }


    // =========================
    // FUNCTIONS
    // =========================

    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email.matches(
          '.*@triamudomsouth[.]ac[.]th'
        );
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email
          == '11076@triamudomsouth.ac.th';
    }


    // =========================
    // PRODUCT VALIDATION
    // =========================

    function validProduct(data) {
      return data.keys().hasAll([
        'name',
        'price',
        'cat',
        'desc',
        'seller',
        'room',
        'line',
        'image',
        'uid',
        'createdAt'
      ])

      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120

      && data.price is number
      && data.price >= 0
      && data.price <= 1000000

      && data.cat is string

      && data.desc is string
      && data.desc.size() <= 1000

      && data.seller is string
      && data.seller.size() > 0
      && data.seller.size() <= 80

      && data.room is string
      && data.room.size() <= 40

      && data.line is string
      && data.line.size() <= 80

      && data.uid is string

      && (data.image == null || data.image is string);
    }
  }
}
