rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // PRODUCTS
    // =========================
    match /products/{productId} {
      allow read: if
        resource.data.approved == true
        || (request.auth != null && resource.data.uid == request.auth.uid)
        || isAdmin();

      allow create: if
        isSchoolUser()
        && request.resource.data.uid == request.auth.uid
        && validProduct(request.resource.data);

      allow update: if
        (
          isSchoolUser()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved == resource.data.approved
          && request.resource.diff(resource).affectedKeys().hasOnly([
            'name','price','cat','desc','seller','room','line','image'
          ])
          && validProduct(request.resource.data)
        )
        ||
        (
          isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved is bool
          && validProduct(request.resource.data)
        );

      allow delete: if
        (isSchoolUser() && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    // =========================
    // CHAT V2: CONVERSATIONS
    // =========================
    match /conversations/{conversationId} {

      // A conversation can only be created for exactly two school users.
      // The seller must actually own the product.
      allow create: if
        isSchoolUser()
        && request.resource.data.conversationId == conversationId
        && request.resource.data.productId is string
        && request.resource.data.sellerUid is string
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0] != request.resource.data.participantUids[1]
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.sellerUid in request.resource.data.participantUids
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.uid == request.resource.data.sellerUid;

      // Inbox query: only members of a conversation can read it.
      allow read: if
        isAdmin()
        || (
          request.auth != null
          && resource.data.participantUids is list
          && request.auth.uid in resource.data.participantUids
        );

      // Only members can update conversation metadata.
      allow update: if
        isSchoolUser()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.diff(resource).affectedKeys().hasOnly([
          'updatedAt','lastText','lastSenderUid','unreadCounts'
        ]);

      // We hide the conversation instead of cascading deletes, because
      // Firestore does not automatically delete subcollection messages.
      allow delete: if false;

      // =========================
      // CHAT V2: MESSAGES
      // =========================
      match /messages/{messageId} {
        allow create: if
          isSchoolUser()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.visible == true
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantUids;

        allow read: if
          isAdmin()
          || (
            request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participantUids
          );

        allow update: if false;

        allow delete: if
          isAdmin()
          || (
            request.auth != null
            && request.resource == resource
            && request.auth.uid == resource.data.senderUid
          );
      }
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
    }

    // =========================
    // FUNCTIONS
    // =========================
    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@triamudomsouth[.]ac[.]th');
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == '11076@triamudomsouth.ac.th';
    }

    function validProduct(data) {
      return data.keys().hasAll([
        'name','price','cat','desc','seller','room','line','image','uid','createdAt'
      ])
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120
      && data.price is number
      && data.price >= 0
      && data.price <= 1000000
      && data.cat is string
      && data.desc is string
      && data.desc.size() <= 1000
      && data.seller is string
      && data.seller.size() > 0
      && data.seller.size() <= 80
      && data.room is string
      && data.room.size() <= 40
      && data.line is string
      && data.line.size() <= 80
      && data.uid is string
      && (data.image == null || data.image is string);
    }
  }
}
